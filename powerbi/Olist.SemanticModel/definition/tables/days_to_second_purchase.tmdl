table days_to_second_purchase
	lineageTag: 7b3fe5bc-3cd5-8757-0b38-e649e8bfde04

	measure 'Share of Repeat Customers' = DIVIDE(SUM(days_to_second_purchase[pct]), 100)
		formatString: 0.0%
		displayFolder: Retention
		lineageTag: 794056da-05af-f521-5285-043f303ea4eb

	column gap_bucket
		dataType: string
		lineageTag: d7024913-93fd-7aac-0abf-94de0be42c09
		summarizeBy: none
		sourceColumn: gap_bucket

		annotation SummarizationSetBy = Automatic

	column customers
		dataType: int64
		formatString: #,0
		lineageTag: 84415cc1-06fb-1d5a-9d95-304b8c98ed71
		summarizeBy: none
		sourceColumn: customers

		annotation SummarizationSetBy = Automatic

	column pct
		dataType: double
		formatString: 0.0"%"
		lineageTag: 5158e48e-be17-bb5c-606a-e6739de897e6
		summarizeBy: none
		sourceColumn: pct

		annotation SummarizationSetBy = Automatic

	column cumulative_pct
		dataType: double
		formatString: 0.0"%"
		lineageTag: b1540e1e-72bf-96a1-85d9-b0ead48fa0cc
		summarizeBy: none
		sourceColumn: cumulative_pct

		annotation SummarizationSetBy = Automatic

	partition days_to_second_purchase = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "days_to_second_purchase.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"gap_bucket", type text}, {"customers", Int64.Type}, {"pct", type number}, {"cumulative_pct", type number}}, "en-US")
				in
				    Typed

