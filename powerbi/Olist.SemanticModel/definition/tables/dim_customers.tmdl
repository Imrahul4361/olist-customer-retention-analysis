	partition dim_customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customers.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"customer_id", type text}, {"n_orders", Int64.Type}, {"n_purchase_days", Int64.Type}, {"lifetime_value", type number}, {"first_purchase_date", type date}, {"last_purchase_date", type date}, {"is_repeat", Int64.Type}, {"repeat_180d", Int64.Type}, {"first_order_late", Int64.Type}, {"first_order_review", type number}, {"first_order_category", type text}, {"customer_state", type text}, {"first_payment_type", type text}, {"first_order_value", type number}}, "en-US"),
				    WithDelivery = Table.AddColumn(Typed, "First Order Delivery", each if [first_order_late] = 1 then "Late" else "On time / early", type text),
				    WithBand = Table.AddColumn(WithDelivery, "First Rating Band", each let s = [first_order_review] in if s = null then "No review" else if s <= 2 then "1-2 stars" else if s <= 3 then "3 stars" else "4-5 stars", type text),
				    WithWindow = Table.AddColumn(WithBand, "Full 180d Window", each if [first_purchase_date] < #date(2018, 3, 1) then 1 else 0, Int64.Type)
				in
				    WithWindow

