table dim_customers
	lineageTag: fbd498cd-a1db-328c-224e-6b359d435b56

	measure 'Customer Count' = COUNTROWS(dim_customers)
		formatString: #,0
		displayFolder: Retention
		lineageTag: 230713e0-e81a-64f2-2e5f-2094b5076d6a

	measure 'Repeat Customers' = SUM(dim_customers[is_repeat])
		formatString: #,0
		displayFolder: Retention
		lineageTag: a056ca40-804c-dc81-6e07-dcc2e98af211

	measure 'Repeat Rate' = DIVIDE([Repeat Customers], [Customer Count])
		formatString: 0.00%
		displayFolder: Retention
		lineageTag: 012dd37e-ba94-1228-10a1-88c810733bc0

	measure 'Repeat 180d Rate' = CALCULATE(AVERAGE(dim_customers[repeat_180d]), dim_customers[Full 180d Window] = 1)
		formatString: 0.00%
		displayFolder: Retention
		lineageTag: 519f8d8a-752d-9ce1-9e5e-9cf9c6a3dd57

	measure 'Repeat 180d Rate (n>=500)' = IF(CALCULATE(COUNTROWS(dim_customers), dim_customers[Full 180d Window] = 1) >= 500, [Repeat 180d Rate])
		formatString: 0.00%
		displayFolder: Retention
		lineageTag: 1c133f59-61f1-ce37-48aa-832f2f518c35

	measure 'Avg Lifetime Value' = AVERAGE(dim_customers[lifetime_value])
		formatString: #,0.00
		displayFolder: Retention
		lineageTag: 14cb3ef9-606e-a7a9-8b22-f3e98a98b8ce

	measure 'Repeat Revenue Share' = DIVIDE(CALCULATE(SUM(dim_customers[lifetime_value]), dim_customers[is_repeat] = 1), SUM(dim_customers[lifetime_value]))
		formatString: 0.0%
		displayFolder: Retention
		lineageTag: 59d2bf09-e21f-6723-5aa4-2496109a524e

