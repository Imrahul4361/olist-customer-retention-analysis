table fact_orders
	lineageTag: 5b85f1bb-1542-ef2b-e474-ca1d49423409

	measure 'Orders' = COUNTROWS(fact_orders)
		formatString: #,0
		displayFolder: Volume
		lineageTag: 98957d82-4f31-2293-1a9c-391f7cce5d97

	measure 'Revenue' = SUM(fact_orders[order_value])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 3e3dfd87-141c-7092-3921-7dd622a56a28

	measure 'Avg Order Value' = DIVIDE([Revenue], [Orders])
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: c69457a5-5f47-4ee3-4c1b-150cb725e5a3

	measure 'Customers' = DISTINCTCOUNT(fact_orders[customer_id])
		formatString: #,0
		displayFolder: Volume
		lineageTag: b32712bf-8679-9f3b-ba65-b2667170e50e

	measure 'Sellers' = DISTINCTCOUNT(fact_orders[seller_id])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 6b173008-3376-23bd-56e4-e07b979748ea

	measure 'Late Orders' = SUM(fact_orders[is_late])
		formatString: #,0
		displayFolder: Delivery
		lineageTag: fc788350-e747-c709-5017-7111db9be768

	measure 'Late Rate' = DIVIDE([Late Orders], [Orders])
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: dec58af7-4ee0-2f85-8dff-03a835a269c8

	measure 'Avg Delivery Days' = AVERAGE(fact_orders[delivery_days])
		formatString: #,0.0
		displayFolder: Delivery
		lineageTag: 1e4e97fe-3889-8765-d219-95e0c882689a

	measure 'Avg Days vs Promise' = AVERAGE(fact_orders[days_vs_promise])
		formatString: #,0.0
		displayFolder: Delivery
		lineageTag: ae79e31b-43af-4800-2e81-545498ebff47

	measure 'Share of Late Orders' = DIVIDE([Late Orders], CALCULATE([Late Orders], ALL(fact_orders)))
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 5d32faba-1e39-466d-a3cd-bc4146974507

	measure 'Late vs National' = DIVIDE([Late Rate], CALCULATE([Late Rate], ALL(fact_orders)))
		formatString: 0.00"x"
		displayFolder: Delivery
		lineageTag: 7a02c594-003c-912e-5478-53d9551ee91d

	measure 'Avg Review' = AVERAGE(fact_orders[review_score])
		formatString: #,0.00
		displayFolder: Satisfaction
		lineageTag: 05df89ca-f49f-a064-7448-4a575e54e446

	measure 'Negative Review Rate' = DIVIDE(SUM(fact_orders[is_negative_review]), COUNT(fact_orders[review_score]))
		formatString: 0.0%
		displayFolder: Satisfaction
		lineageTag: 8b6e8bac-f313-6922-cc80-153ac11c6a38

	measure 'Freight Share' = DIVIDE(SUM(fact_orders[freight_value]), SUM(fact_orders[items_price]))
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: 1257825b-ef52-b5ca-ee1a-b3580a79d662

