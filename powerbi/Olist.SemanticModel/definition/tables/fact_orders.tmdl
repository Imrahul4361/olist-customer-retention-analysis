	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_orders.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"order_id", type text}, {"customer_id", type text}, {"customer_state", type text}, {"purchased_at", type datetime}, {"purchase_date", type date}, {"purchase_month", type datetime}, {"delivered_at", type datetime}, {"promised_at", type datetime}, {"delivery_days", Int64.Type}, {"days_vs_promise", Int64.Type}, {"is_late", Int64.Type}, {"review_score", type number}, {"is_negative_review", Int64.Type}, {"order_value", type number}, {"payment_type", type text}, {"installments", Int64.Type}, {"n_items", Int64.Type}, {"n_sellers", Int64.Type}, {"seller_id", type text}, {"seller_state", type text}, {"category", type text}, {"items_price", type number}, {"freight_value", type number}, {"route", type text}}, "en-US"),
				    Filtered = Table.SelectRows(Typed, each [purchase_month] >= #datetime(2017,1,1,0,0,0) and [purchase_month] < #datetime(2018,9,1,0,0,0)),
				    WithMonth = Table.AddColumn(Filtered, "Month", each Date.From([purchase_month]), type date),
				    WithYear = Table.AddColumn(WithMonth, "Year", each Date.Year([purchase_month]), Int64.Type),
				    WithStatus = Table.AddColumn(WithYear, "Delivery Status", each if [is_late] = 1 then "Late" else "On time / early", type text),
				    WithBucket = Table.AddColumn(WithStatus, "Delay Bucket", each let d = [days_vs_promise] in if d = null then null else if d <= -10 then "10+ days early" else if d <= -1 then "1-9 days early" else if d = 0 then "On promised day" else if d <= 3 then "1-3 days late" else if d <= 7 then "4-7 days late" else "8+ days late", type text),
				    WithOrder = Table.AddColumn(WithBucket, "Delay Order", each let d = [days_vs_promise] in if d = null then null else if d <= -10 then 1 else if d <= -1 then 2 else if d = 0 then 3 else if d <= 3 then 4 else if d <= 7 then 5 else 6, Int64.Type)
				in
				    WithOrder

