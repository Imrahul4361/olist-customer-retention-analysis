model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "fact_orders", "dim_customers", "customer_segments", "days_to_second_purchase", "cohort_retention"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table fact_orders
ref table dim_customers
ref table customer_segments
ref table days_to_second_purchase
ref table cohort_retention

